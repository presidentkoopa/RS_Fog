OptionMenu "RSFMain"
{
	Title "Fog"
	StaticText "Mist with a real ceiling -- stand knee deep in", "gray"
	StaticText "it and look down at its surface. Worked out per", "gray"
	StaticText "pixel rather than by marching a ray, which is", "gray"
	StaticText "why it runs at VR framerates at all.", "gray"
	StaticText ""
	Option "Enabled", "rsf_enabled", "OnOff"
	Option "Preset", "rsf_preset", "RSF_Preset"
	StaticText "A preset sets the look below. It never touches", "gold"
	StaticText "the switches on the Events page.", "gold"
