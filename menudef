OptionMenu "RSFRooms"
{
	Title "Indoors and Outdoors"
	StaticText "A sky ceiling is how Doom marks outdoors, so this", "gray"
	StaticText "works on any map without it being authored for it.", "gray"
	StaticText ""
	Slider "Indoors", "rsf_indoor", 0.0, 2.0, 0.05, 2
	Slider "Outdoors", "rsf_outdoor", 0.0, 2.0, 0.05, 2
	StaticText "Multiplies the density above. Both 1.00 is one fog", "gray"
	StaticText "everywhere, which is how it used to be.", "gray"
	StaticText ""
	StaticText "ROOMS WITH WINDOWS work out of this for free.", "gold"
	StaticText "The split is per surface, so the far wall seen", "gray"
	StaticText "through a window is an outdoor draw and fogs like", "gray"
	StaticText "one, while the room you are standing in does not.", "gray"
	StaticText "You see weather you are not standing in.", "gray"
	StaticText ""
	StaticText "Set indoors to 0 for weather that stops at the", "gray"
	StaticText "door. A small value reads better than none -- a", "gray"
	StaticText "room at 0 next to open air at 1.5 looks like two", "gray"
	StaticText "unrelated places.", "gray"
}

